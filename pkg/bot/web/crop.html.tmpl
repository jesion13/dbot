<!DOCTYPE html>
<style>

:root {
  color-scheme: dark;
  --bg: #181818;
  --panel: #202020;
  --panel-alt: #252525;
  --border: #383838;
  --text: #dedede;
  --muted: #929292;
  --accent: #b8b8b8;
  --green: #80c080;
  --danger: #e07070;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  background: var(--bg);
  color: var(--text);
  font: 13px/1.5 system-ui, sans-serif;
}

.app {
  width: min(1200px, 100%);
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon {
  display: none;
}

.brand h1 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: 0;
}

.brand p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 11px;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
}

.workspace {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 270px;
  align-items: start;
  gap: 14px;
}

.panel {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--panel);
  box-shadow: none;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 11px 13px;
  border-bottom: 1px solid var(--border);
  background: var(--panel-alt);
}

.panel-heading h2 {
  margin: 0;
  font-size: 12px;
  font-weight: 600;
}

.eyebrow {
  color: var(--muted);
  font: 10px/1.4 ui-monospace, monospace;
  letter-spacing: .4px;
}

.video-area {
  padding: 12px;
}

#stage {
  position: relative;
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  border: 1px solid #444;
  border-radius: 2px;
  background: #000;
  touch-action: none;
  user-select: none;
}

video {
  display: block;
  width: 100%;
  height: auto;
  max-height: 70vh;
  background: #000;
}

#box {
  position: absolute;
  border: 1px solid #80c080;
  box-shadow: 0 0 0 1px #000;
  display: none;
  pointer-events: none;
}

#box.on {
  display: block;
}

.h {
  position: absolute;
  width: 10px;
  height: 10px;
  margin: -5px 0 0 -5px;
  border: 1px solid #111;
  border-radius: 0;
  background: var(--green);
  pointer-events: auto;
}

#h-nw { left: 0; top: 0; cursor: nwse-resize; }
#h-ne { left: 100%; top: 0; cursor: nesw-resize; }
#h-sw { left: 0; top: 100%; cursor: nesw-resize; }
#h-se { left: 100%; top: 100%; cursor: nwse-resize; }

.video-hint {
  margin-top: 8px;
  color: var(--muted);
  font-size: 11px;
}

.video-hint span {
  color: var(--green);
}

.transport {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-top: 1px solid var(--border);
  background: #1b1b1b;
}

button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 30px;
  padding: 5px 9px;
  border: 1px solid #454545;
  border-radius: 3px;
  background: #303030;
  color: var(--text);
  font: 12px system-ui, sans-serif;
  cursor: pointer;
}

button:hover:not(:disabled) {
  background: #3a3a3a;
  border-color: #606060;
}

button:active:not(:disabled) {
  background: #292929;
}

button:disabled {
  opacity: .45;
  cursor: default;
}

#play {
  flex: 0 0 32px;
  width: 32px;
  min-height: 30px;
  padding: 0;
  border-radius: 3px;
  background: #303030;
  border-color: #454545;
  color: var(--text);
}

/* emoji-only jump buttons: the glyph is the label, so centre it */
#goStart, #goEnd {
  justify-content: center;
  font-size: 15px;
}

input[type="range"] {
  flex: 1;
  min-width: 0;
  accent-color: #aaa;
  cursor: pointer;
}

#time {
  color: #aaa;
  font: 11px ui-monospace, monospace;
  white-space: nowrap;
}

.section {
  min-width: 0;
  padding: 13px;
  border-bottom: 1px solid var(--border);
}

.section:last-child {
  border-bottom: 0;
}

.section-title {
  margin: 0 0 12px;
  color: #c6c6c6;
  font-size: 11px;
  font-weight: 600;
}

.field-label {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-size: 11px;
}

.time-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

input[type="number"],
select {
  width: 100%;
  min-width: 0;
  height: 31px;
  padding: 4px 7px;
  border: 1px solid #424242;
  border-radius: 3px;
  outline: none;
  background: #171717;
  color: var(--text);
  font: 12px ui-monospace, monospace;
}

input:focus,
select:focus {
  border-color: #888;
}

.button-stack {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 9px;
}

.button-stack button {
  width: 100%;
  justify-content: flex-start;
  text-align: left;
}

.button-stack button span {
  width: 15px;
  color: var(--muted);
  text-align: center;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 30px;
  color: var(--text);
  font-size: 12px;
  cursor: pointer;
}

input[type="checkbox"] {
  accent-color: #aaa;
  cursor: pointer;
}

.format-select {
  margin-top: 10px;
}

#preview {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

#pv {
  display: block;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 620px;
  border: 1px solid #454545;
  border-radius: 2px;
  background: #000;
  object-fit: contain;
}

#pvsize {
  color: #aaa;
  font: 11px ui-monospace, monospace;
}

.preview-frame {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: 2px;
  background: #151515;
}

.preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
}

.preview-heading h3 {
  margin: 0;
  font-size: 11px;
  font-weight: 600;
}

.tag {
  padding: 2px 5px;
  border: 1px solid #454545;
  border-radius: 2px;
  color: var(--muted);
  font: 10px ui-monospace, monospace;
}

.export-section {
  background: #222;
}

#submit {
  width: 100%;
  min-height: 34px;
  border-color: #666;
  border-radius: 3px;
  background: #383838;
  color: #eee;
  font-weight: 600;
}

#submit:hover:not(:disabled) {
  background: #454545;
}

#note {
  min-height: 18px;
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 11px;
  overflow-wrap: anywhere;
}

#note.err {
  color: var(--danger);
}

@media (max-width: 820px) {
  body {
    padding: 12px;
  }

  .workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .settings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .settings > .panel-heading {
    grid-column: 1 / -1;
  }

  .settings > .section:last-child {
    grid-column: 1 / -1;
  }
}

@media (max-width: 480px) {
  body {
    padding: 8px;
  }

  .settings {
    grid-template-columns: minmax(0, 1fr);
  }

  .settings > .section:last-child {
    grid-column: auto;
  }

  .topbar {
    align-items: flex-start;
  }

  .status-pill {
    font-size: 10px;
  }

  #time {
    font-size: 10px;
  }
}
.time-button-row {
  display: flex;
  align-items: stretch;
  gap: 6px;
}

.time-button-row > button:first-child {
  flex: 1;
  min-width: 0;
  justify-content: flex-start;
  text-align: left;
}

.time-button-row .jump-button {
  flex: 0 0 38px;
  width: 38px;
  padding: 5px;
  justify-content: center;
  font-size: 15px;
}
</style>

<div class="app">
  <main class="workspace">
    <section class="panel">
      <div class="panel-heading">
        <h2>Podgląd wideo</h2>
        <span class="eyebrow">CROP EDITOR</span>
      </div>

      <div class="video-area">
        <div id="stage">
          <video id="v" src="{{.Path}}/video"
                 preload="auto" playsinline></video>
          <div id="box">
            <div class="h" id="h-nw"></div>
            <div class="h" id="h-ne"></div>
            <div class="h" id="h-sw"></div>
            <div class="h" id="h-se"></div>
          </div>
        </div>

        <div class="video-hint">
          <span>✥</span>
          Przeciągnij, aby zaznaczyć kadr. Złap narożnik, aby zmienić rozmiar.
        </div>
      </div>

      <div class="transport">
        <button id="play" aria-label="Odtwórz">&#9654;</button>
        <input id="seek" type="range" min="0" max="1000" value="0"
               aria-label="Pozycja wideo">
        <span id="time">0:00</span>
      </div>

      <div class="section">
        <div class="preview-heading">
          <h3>Podgląd wycinka</h3>
          <span class="tag">LIVE</span>
        </div>
        <div class="preview-frame">
          <canvas id="pv"></canvas>
        </div>
        <div id="pvsize" style="margin-top: 9px;">Oczekiwanie na klatkę…</div>
      </div>
    </section>

    <aside class="panel settings">
      <div class="panel-heading" style="grid-column: 1 / -1;">
        <h2>Ustawienia eksportu</h2>
        <span class="eyebrow">SETTINGS</span>
      </div>

      <section class="section">
        <h3 class="section-title">01 / Zakres czasowy</h3>

        <div class="time-grid">
          <div>
            <label class="field-label" for="start">Początek (s)</label>
            <input id="start" type="number" step="0.1" min="0"
                   placeholder="0.0">
          </div>
          <div>
            <label class="field-label" for="end">Koniec (s)</label>
            <input id="end" type="number" step="0.1" min="0"
                   placeholder="0.0">
          </div>
        </div>

<div class="button-stack">
  <div class="time-button-row">
    <button id="setStart"><span>↳</span> Ustaw początek</button>
    <button id="goStart" class="jump-button"
            title="Skocz do ustawionego początku"
            aria-label="Skocz do ustawionego początku">⏮</button>
  </div>

  <div class="time-button-row">
    <button id="setEnd"><span>↳</span> Ustaw koniec</button>
    <button id="goEnd" class="jump-button"
            title="Skocz do ustawionego końca"
            aria-label="Skocz do ustawionego końca">⏭</button>
  </div>
</div>
      </section>


      <section class="section">
        <h3 class="section-title">02 / Kadrowanie</h3>
        <p style="margin: 0; color: var(--muted); font-size: 12px;">
          Wybierz fragment wideo, który chcesz zachować. Możesz przesuwać
          zaznaczenie i regulować jego narożniki.
        </p>
        <div class="button-stack">
          <button id="all"><span>⛶</span> Pełna klatka</button>
        </div>
      </section>

      <section class="section">
        <h3 class="section-title">03 / Format i dźwięk</h3>

        <label class="check-row" for="mute">
          <input id="mute" type="checkbox">
          Wycisz dźwięk
        </label>

        <div class="format-select">
          <label class="field-label" for="format">Format wyjściowy</label>
          <select id="format">
            <option value="mp4">MP4 · Wideo</option>
            <option value="gif">GIF · Animacja</option>
          </select>
        </div>
      </section>

      <section class="section export-section">
        <h3 class="section-title">04 / Eksport</h3>
        <button id="submit"><span>✦</span> Zatwierdź </button>
        <p id="note" role="status" aria-live="polite">
          Gotowe do pracy. Zaznacz obszar i rozpocznij eksport.
        </p>
      </section>
    </aside>
  </main>
</div>


<script>
const $ = (id) => document.getElementById(id);
const v = $("v"), stage = $("stage"), box = $("box"), note = $("note");
// the server's idea of the frame, only shown so a wrong number is visible to the user
const dims = "{{.Width}}x{{.Height}}";
let rect = { x: 0, y: 0, w: 1, h: 1 };
let mode = null; // draw | move | resize
let from = null;

function show() {
  box.classList.add("on");
  box.style.left = (rect.x * 100) + "%";
  box.style.top = (rect.y * 100) + "%";
  box.style.width = (rect.w * 100) + "%";
  box.style.height = (rect.h * 100) + "%";
  preview();
}

const pv = $("pv"), pvsize = $("pvsize");

// the same fractions the server gets, painted out of the current frame
function preview() {
  const iw = v.videoWidth, ih = v.videoHeight;
  if (!iw || !ih || v.readyState < 2) return;
  const sx = Math.round(rect.x * iw), sy = Math.round(rect.y * ih);
  const sw = Math.max(1, Math.round(rect.w * iw)), sh = Math.max(1, Math.round(rect.h * ih));
  if (pv.width !== sw) pv.width = sw;
  if (pv.height !== sh) pv.height = sh;
  pv.getContext("2d").drawImage(v, sx, sy, sw, sh, 0, 0, sw, sh);
  pvsize.textContent = sw + "x" + sh + (rect.w >= 1 && rect.h >= 1 ? " (no crop)" : "");
}

// pointer position as a fraction of the video, clamped to it
function at(e) {
  const r = v.getBoundingClientRect();
  return {
    x: Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)),
    y: Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)),
  };
}

// which corner of the box the pointer is on, "" if on none
function cornerAt(p) {
  const near = (a, b) => Math.abs(a - b) < 0.035;
  const left = near(p.x, rect.x), right = near(p.x, rect.x + rect.w);
  const top = near(p.y, rect.y), bottom = near(p.y, rect.y + rect.h);
  return (left || right) && (top || bottom) ? { left, right, top, bottom } : null;
}

stage.addEventListener("pointerdown", (e) => {
  const p = at(e);
  const c = box.classList.contains("on") ? cornerAt(p) : null;
  if (c) {
    // the corner being dragged moves, the opposite one is the anchor
    mode = "resize";
    from = { x: c.right ? rect.x : rect.x + rect.w, y: c.bottom ? rect.y : rect.y + rect.h };
  } else if (box.classList.contains("on") && p.x > rect.x && p.x < rect.x + rect.w && p.y > rect.y && p.y < rect.y + rect.h) {
    mode = "move";
    from = p;
  } else {
    mode = "draw";
    from = p;
  }
  stage.setPointerCapture(e.pointerId);
  show();
  e.preventDefault();
});

stage.addEventListener("pointermove", (e) => {
  if (!mode) return;
  const p = at(e);
  if (mode === "draw" || mode === "resize") {
    // both grow from the anchor, so a drag past it just flips the box
    rect = {
      x: Math.min(from.x, p.x), y: Math.min(from.y, p.y),
      w: Math.max(0.01, Math.abs(p.x - from.x)), h: Math.max(0.01, Math.abs(p.y - from.y)),
    };
  } else {
    rect.x = Math.min(Math.max(0, rect.x + (p.x - from.x)), 1 - rect.w);
    rect.y = Math.min(Math.max(0, rect.y + (p.y - from.y)), 1 - rect.h);
    from = p;
  }
  show();
});

stage.addEventListener("pointerup", () => { mode = null; });

$("all").onclick = () => { rect = { x: 0, y: 0, w: 1, h: 1 }; show(); };

$("play").onclick = () => { if (v.paused) { v.play(); } else { v.pause(); } };
v.addEventListener("play", () => { $("play").innerHTML = "&#10073;&#10073;"; });
v.addEventListener("pause", () => { $("play").innerHTML = "&#9654;"; });
$("seek").addEventListener("input", () => { v.currentTime = v.duration * $("seek").value / 1000; });
// the preview follows the playhead, so a frame can be checked before it is kept
v.addEventListener("timeupdate", preview);
v.addEventListener("seeked", preview);
v.addEventListener("loadeddata", preview);
v.addEventListener("timeupdate", () => {
  if (v.duration) $("seek").value = v.currentTime / v.duration * 1000;
  $("time").textContent = fmt(v.currentTime) + " / " + fmt(v.duration);
});
v.addEventListener("loadedmetadata", () => {
  if (!$("end").value || $("end").value == 0) $("end").value = v.duration.toFixed(2);
  $("end").max = v.duration.toFixed(2);
  $("start").max = v.duration.toFixed(2);
});

// a gif carries no audio, so muting it is not a thing to ask for
$("format").onchange = () => { $("mute").disabled = $("format").value == "gif"; };

$("setStart").onclick = () => { $("start").value = v.currentTime.toFixed(2); };
$("setEnd").onclick = () => { $("end").value = v.currentTime.toFixed(2); };

// jump the playhead to the typed time so the frame at a bound can be checked;
// values past the end are clamped, empty ones do nothing
const jump = (id) => { const t = parseFloat($(id).value); if (isFinite(t)) v.currentTime = Math.min(t, v.duration); };
$("goStart").onclick = () => jump("start");
$("goEnd").onclick = () => jump("end");

function fmt(s) {
  if (!isFinite(s)) return "0:00";
  const m = Math.floor(s / 60), r = Math.floor(s % 60);
  return m + ":" + String(r).padStart(2, "0");
}

let polling = null;
$("submit").onclick = async () => {
  const body = {
    x: rect.x, y: rect.y, w: rect.w, h: rect.h,
    start: parseFloat($("start").value) || 0,
    end: parseFloat($("end").value) || 0,
    mute: $("mute").checked,
    format: $("format").value,
  };
  note.className = "";
  note.textContent = "sending…";
  $("submit").disabled = true;

  let res;
  try {
    res = await fetch(location.href, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
  } catch (e) {
    note.className = "err";
    note.textContent = "could not reach the bot: " + e;
    $("submit").disabled = false;
    return;
  }

  if (!res.ok) {
    note.className = "err";
    note.textContent = await res.text();
    $("submit").disabled = false;
    return;
  }

  note.textContent = "encoding, this can take a while…";
  polling = setInterval(poll, 3000);
};

async function poll() {
  let res;
  try {
    res = await fetch("{{.Path}}/status");
  } catch (e) {
    note.className = "err";
    note.textContent = "cannot reach the bot, retrying…";
    return;
  }
  if (res.status == 404) {
    clearInterval(polling);
    $("submit").disabled = false;
    note.className = "err";
    note.textContent = "this crop link is gone";
    return;
  }

  // anything that is not our json (a proxy's error page) means try again, not "done"
  let s = {};
  try { s = await res.json(); } catch (e) {
    note.className = "err";
    note.textContent = "the bot answered something odd, retrying…";
    return;
  }
  if (s.state == "encoding" || !s.state) return;

  clearInterval(polling);
  $("submit").disabled = false;
  note.className = s.error ? "err" : "";
  note.textContent = s.error ? s.error : "done, it should be in Discord (frame " + dims + ")";
}

show();
</script>
</body>
</html>
